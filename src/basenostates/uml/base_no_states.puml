@startuml classDiagram
    class Main {
        +main(args: String[])
    }

    class DirectoryDoors <<Singleton>> {
        -{static} instance: DirectoryDoors
        -allDoors: ArrayList~Door~
        +{static} getInstance(): DirectoryDoors
        +findDoorById(id: String): Door
        +getAllDoors(): ArrayList~Door~
    }

    class DirectoryUsers <<Singleton>> {
        -{static} instance: DirectoryUsers
        -users: ArrayList~User~
        -rolesMap: Map~String, AuthGroup~
        +{static} getInstance(): DirectoryUsers
        +findUserByCredential(credential: String): User
        +getUsers(): ArrayList~User~
    }

    class DirectoryAreas <<Singleton>> {
        -{static} instance: DirectoryAreas
        -areas: ArrayList~Area~
        +{static} getInstance(): DirectoryAreas
        +findArea(id: String): Area
        +getAreas(): ArrayList~Area~
    }

    class User {
        -name: String
        -credential: String
        -role: String
        -authGroup: AuthGroup
        +getAuthGroup(): AuthGroup
        +toString(): String
    }

    class AuthGroup {
        -actions: ArrayList~String~
        -allowedAreas: ArrayList~Area~
        -schedule: Schedule
        +checkPermissions(action: String, door: Door, now: LocalDateTime, role: String): ArrayList~String~
        +isAllowed(action: String, id: String, now: LocalDateTime): boolean
    }

    class Schedule {
        -startDate: LocalDate
        -endDate: LocalDate
        -startTime: LocalTime
        -endTime: LocalTime
        -daysOfWeek: ArrayList~DayOfWeek~
        +isWorking(dateTime: LocalDateTime): boolean
    }

    class Door {
        -id: String
        -fromSpace: String
        -toSpace: String
        -closed: boolean
        -state: DoorState
        +processRequest(request: RequestReader)
        +setState(doorState: DoorState)
        +getFromSpace(): String
        +getToSpace(): String
        +toJson(): JSONObject
    }

    class DoorState <<State>> {
        <<abstract>>
        #door: Door
        +{abstract} unlock()
        +{abstract} open()
        +{abstract} lock()
        +{abstract} close()
        +unlockShortly()
    }

    class Locked {
        +lock()
        +unlock()
        +unlockShortly()
        +open()
        +close()
    }
    class Unlocked {
        +lock()
        +unlock()
        +unlockShortly()
        +open()
        +close()
    }
    class Propped {
        +lock()
        +unlock()
        +unlockShortly()
        +open()
        +close()
    }
    class UnlockedShortly {
        -remainingSeconds: int
        +update(o: Observable, arg: Object)
        +close()
    }

    class Clock <<Singleton>> {
        -{static} instance: Clock
        +{static} getInstance(): Clock
        +start()
        +stop()
    }

    class Area <<Composite>> {
        <<abstract>>
        #id: String
        +{abstract} acceptVisitor(v: Visitor)
        +{abstract} toJson(depth: int): JSONObject
    }

    class Partition {
        -spaces: ArrayList~Area~
        +getSpaces(): ArrayList~Area~
        +acceptVisitor(v: Visitor)
    }

    class Space {
        -doors: ArrayList~Door~
        +getDoors(): ArrayList~Door~
        +acceptVisitor(v: Visitor)
    }

    class Visitor <<Visitor>> {
        <<interface>>
        +{abstract} visitSpace(s: Space)
        +{abstract} visitPartition(p: Partition)
        +{abstract} getArea(): Area
        +{abstract} getDoors(): ArrayList~Door~
    }

    class AreaFinder {
        -id: String
        -area: Area
        +visitSpace(s: Space)
        +visitPartition(p: Partition)
    }

    class AccessDoors {
        -doors: ArrayList~Door~
        +visitSpace(s: Space)
        +visitPartition(p: Partition)
    }

    class WebServer {
        -PORT: int
        +{static} logActivity(request: Request)
    }

    Main ..> DirectoryDoors : gets instance
    Main ..> DirectoryUsers : gets instance
    Main ..> DirectoryAreas : gets instance
    Main ..> WebServer : starts

    DirectoryDoors "1" *-- "*" Door
    DirectoryUsers "1" *-- "*" User
    DirectoryAreas "1" *-- "*" Area
    
    User --> AuthGroup
    AuthGroup --> Schedule
    AuthGroup ..> AreaFinder : uses
    
    Door --> DoorState
    DoorState <|-- Locked
    DoorState <|-- Unlocked
    DoorState <|-- Propped
    DoorState <|-- UnlockedShortly
    
    UnlockedShortly ..> Clock : observes
    
    Area <|-- Partition
    Area <|-- Space
    Partition "1" o-- "*" Area
    Space "1" o-- "*" Door
    
    Visitor <|.. AreaFinder
    Visitor <|.. AccessDoors
    Area ..> Visitor : accepts
@enduml