<configuration>

    <!-- Console Appender -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Activity Log File Appender (Section 6.3) -->
    <appender name="ACTIVITY_FILE" class="ch.qos.logback.core.FileAppender">
        <file>activity.log</file>
        <append>true</append>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!--
    ================================================================================
    LOGGING CONFIGURATION OPTIONS (Section 6.3)
    Uncomment only ONE of the three options below:
    ================================================================================
    -->

    <!-- Option 1: Log messages from classes of the FIRST MILESTONE only
    <logger name="basenostates.Door" level="DEBUG" />
    <logger name="basenostates.doorstate" level="DEBUG" />
    <logger name="basenostates.requests" level="DEBUG" />
    <logger name="basenostates.AuthGroup" level="DEBUG" />
    <logger name="basenostates.Clock" level="DEBUG" />
    <logger name="basenostates.WebServer" level="OFF" />
    <root level="OFF">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="ACTIVITY_FILE" />
    </root>
    -->

    <!-- Option 2: Log messages from classes of the SECOND MILESTONE only
    <logger name="basenostates.WebServer" level="INFO" />
    <logger name="basenostates.DirectoryDoors" level="INFO" />
    <logger name="basenostates.DirectoryAreas" level="INFO" />
    <logger name="basenostates.DirectoryUsers" level="INFO" />
    <logger name="basenostates.AreaFinder" level="DEBUG" />
    <logger name="basenostates.AccessDoors" level="DEBUG" />
    <root level="OFF">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="ACTIVITY_FILE" />
    </root>
    -->

    <!-- Option 3: Log messages from ALL classes (Active by default) -->
    <logger name="basenostates" level="DEBUG" />
    <root level="INFO">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="ACTIVITY_FILE" />
    </root>

</configuration>
